<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/pad">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/personality_title"
            android:textColor="@color/text"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/personality_pet_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/personality_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="@dimen/text_body"
            android:fontFamily="monospace"
            android:layout_marginBottom="@dimen/pad" />

        <LinearLayout
            android:id="@+id/trait_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/pad_small"
            android:layout_marginBottom="@dimen/pad" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/personality_says"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/text_small"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/personality_says"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pet_cheek"
            android:textSize="@dimen/text_body"
            android:fontFamily="monospace"
            android:layout_marginBottom="@dimen/pad" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/personality_learned_title"
            android:textColor="@color/text"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/personality_learned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/personality_learned_empty"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/text_body"
            android:fontFamily="monospace"
            android:layout_marginBottom="@dimen/pad" />

        <Button
            android:id="@+id/btn_personality_done"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:background="@drawable/btn_gold"
            android:text="@string/personality_got_it"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
